{
  "version": 1,
  "packages": [
    {
      "path": "packages/wesley-cli",
      "disposition": "delete-after-command-migration"
    },
    {
      "path": "packages/wesley-core",
      "disposition": "port-then-delete"
    },
    {
      "path": "packages/wesley-holmes",
      "disposition": "extract-or-rebuild-later"
    },
    {
      "path": "packages/wesley-host-browser",
      "disposition": "delete-or-externalize"
    },
    {
      "path": "packages/wesley-host-bun",
      "disposition": "delete-or-externalize"
    },
    {
      "path": "packages/wesley-host-deno",
      "disposition": "delete-or-externalize"
    },
    {
      "path": "packages/wesley-host-node",
      "disposition": "delete"
    },
    {
      "path": "packages/wesley-runtime-node",
      "disposition": "extract-or-delete"
    }
  ],
  "retiredPackages": [
    {
      "path": "packages/wesley-generator-vue",
      "disposition": "deleted",
      "slice": "NR-081",
      "replacement": "External Vue projection ownership; generic Wesley no longer carries a built-in Vue generator package."
    },
    {
      "path": "packages/wesley-scaffold-multitenant",
      "disposition": "deleted",
      "slice": "NR-082",
      "replacement": "Product scaffolding is no longer generic Wesley surface area; future scaffolds belong to an owning product repository."
    },
    {
      "path": "packages/wesley-test-fixtures",
      "disposition": "deleted",
      "slice": "NR-083",
      "replacement": "Useful fixtures live as plain files under test/fixtures or Rust tests instead of an npm workspace package."
    },
    {
      "path": "packages/wesley-tasks",
      "disposition": "deleted",
      "slice": "NR-084",
      "replacement": "Rust TransmutationRunner keeps descriptor-only task graph evidence; no generic JavaScript task runtime remains in Wesley."
    },
    {
      "path": "packages/wesley-generator-js",
      "disposition": "deleted",
      "slice": "NR-080",
      "replacement": "Native Rust TypeScript emitters own retained product TypeScript output; Zod remains only as a legacy CLI compatibility projection until extracted or removed with the CLI."
    }
  ],
  "deletionBlockers": [
    {
      "slice": "NR-076",
      "path": "packages/wesley-core",
      "blocker": "Still imported by Holmes, host compatibility packages, the JS generator, and scripts."
    },
    {
      "slice": "NR-077",
      "path": "packages/wesley-cli",
      "blocker": "Still owns legacy assurance/runtime commands and Bats compatibility suites."
    },
    {
      "slice": "NR-078",
      "path": "packages/wesley-host-node",
      "blocker": "Still referenced by compatibility workflows, root scripts, and legacy CLI smoke tests."
    },
    {
      "slice": "NR-079",
      "path": "packages/wesley-runtime-node",
      "blocker": "Still used by Holmes/runtime evidence and parser/parity migration scripts."
    }
  ],
  "commands": [
    {
      "name": "generate",
      "path": "packages/wesley-cli/src/commands/generate.mjs",
      "disposition": "port-generic-pieces-then-delete"
    },
    {
      "name": "transform",
      "path": "packages/wesley-cli/src/commands/transform.mjs",
      "disposition": "delete"
    },
    {
      "name": "compile",
      "path": "packages/wesley-cli/src/commands/compile.mjs",
      "disposition": "defer-then-rebuild"
    },
    {
      "name": "typescript",
      "path": "packages/wesley-cli/src/commands/typescript.mjs",
      "disposition": "partially-ported-to-wesley-emit-typescript"
    },
    {
      "name": "zod",
      "path": "packages/wesley-cli/src/commands/zod.mjs",
      "disposition": "legacy-cli-local-compatibility-projection"
    },
    {
      "name": "models",
      "path": "deleted",
      "disposition": "deleted"
    },
    {
      "name": "init",
      "path": "packages/wesley-cli/src/commands/init.mjs",
      "disposition": "retire-legacy-scaffolding"
    },
    {
      "name": "doctor",
      "path": "packages/wesley-cli/src/commands/doctor.mjs",
      "disposition": "port-narrow"
    },
    {
      "name": "validate-bundle",
      "path": "packages/wesley-cli/src/commands/validate-bundle.mjs",
      "disposition": "defer"
    },
    {
      "name": "runs",
      "path": "packages/wesley-cli/src/commands/runs.mjs",
      "disposition": "extract-or-defer"
    },
    {
      "name": "cert-create",
      "path": "packages/wesley-cli/src/commands/cert-create.mjs",
      "disposition": "extract"
    },
    {
      "name": "cert-sign",
      "path": "packages/wesley-cli/src/commands/cert-sign.mjs",
      "disposition": "extract"
    },
    {
      "name": "cert-verify",
      "path": "packages/wesley-cli/src/commands/cert-verify.mjs",
      "disposition": "extract"
    },
    {
      "name": "cert-badge",
      "path": "packages/wesley-cli/src/commands/cert-badge.mjs",
      "disposition": "extract-or-delete"
    }
  ],
  "frontDoorDocs": ["README.md", "docs/GUIDE.md", "docs/ENTRYPOINTS.md", "docs/END_TO_END.md"],
  "pnpmWesleyCompatibilityContext": [
    "legacy",
    "historical",
    "compatibility",
    "old",
    "retir",
    "migration"
  ],
  "legacyCoreAuthorityPaths": ["packages/wesley-core/src/", "packages/wesley-core/package.json"],
  "legacyCoreAuthorityAllowedChanges": [],
  "ciLaneLabels": {
    "rustProduct": "Rust Product",
    "repositoryHygiene": "Repository Hygiene",
    "legacyCompatibility": "Legacy Compatibility"
  }
}
