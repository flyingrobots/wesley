{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wesley.dev/schemas/realm.schema.json",
  "title": "Wesley REALM Rehearsal Report",
  "type": "object",
  "required": ["verdict", "timestamp"],
  "properties": {
    "transmutation": { "type": ["string", "null"] },
    "runId": { "type": ["string", "null"], "minLength": 1 },
    "resumed": { "type": "boolean" },
    "shortCircuited": { "type": "boolean" },
    "run": { "anyOf": [{ "$ref": "runtime-run.schema.json#" }, { "type": "null" }] },
    "events": {
      "type": "array",
      "items": { "$ref": "runtime-event.schema.json#" }
    },
    "provider": { "type": ["string", "null"] },
    "verdict": { "type": "string", "enum": ["PASS", "FAIL"] },
    "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
    "steps": { "type": ["integer", "null"], "minimum": 0 },
    "error": { "type": ["string", "null"] },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "if": { "required": ["verdict"], "properties": { "verdict": { "const": "FAIL" } } },
  "then": {
    "required": ["error"],
    "properties": { "error": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
