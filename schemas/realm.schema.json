{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wesley.dev/schemas/realm.schema.json",
  "title": "Wesley REALM Rehearsal Report",
  "type": "object",
  "required": ["verdict", "timestamp"],
  "properties": {
    "transmutation": { "type": ["string", "null"] },
    "runId": { "type": ["string", "null"], "minLength": 1 },
    "events": {
      "type": "array",
      "items": { "$ref": "#/definitions/RuntimeEvent" }
    },
    "provider": { "type": ["string", "null"] },
    "verdict": { "type": "string", "enum": ["PASS", "FAIL"] },
    "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
    "steps": { "type": ["integer", "null"], "minimum": 0 },
    "error": { "type": ["string", "null"] },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "if": { "required": ["verdict"], "properties": { "verdict": { "const": "FAIL" } } },
  "then": { "required": ["error"], "properties": { "error": { "type": "string", "minLength": 1 } } },
  "additionalProperties": false,
  "definitions": {
    "RuntimeEvent": {
      "type": "object",
      "required": [
        "eventId",
        "type",
        "streamId",
        "sequence",
        "schemaVersion",
        "timestamp",
        "correlationId",
        "idempotencyKey",
        "runId",
        "transmutation",
        "payload"
      ],
      "properties": {
        "eventId": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "streamId": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "schemaVersion": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "causationId": { "type": ["string", "null"] },
        "correlationId": { "type": ["string", "null"] },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "transmutation": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
