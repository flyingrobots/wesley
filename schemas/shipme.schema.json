{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wesley.dev/schemas/shipme.schema.json",
  "title": "Wesley SHIPME Certificate",
  "type": "object",
  "required": ["sha", "timestamp", "realm"],
  "properties": {
    "version": { "type": "string" },
    "transmutation": { "type": "string" },
    "runId": { "type": "string", "minLength": 1 },
    "resumed": { "type": "boolean" },
    "shortCircuited": { "type": "boolean" },
    "run": { "$ref": "runtime-run.schema.json#" },
    "events": {
      "type": "array",
      "items": { "$ref": "runtime-event.schema.json#" }
    },
    "sha": { "type": "string", "pattern": "^([0-9a-f]{40}([0-9a-f]{24})?|uncommitted)$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "environment": { "type": ["string", "null"] },
    "scores": { "type": ["object", "null"] },
    "realm": {
      "anyOf": [ { "$ref": "realm.schema.json#" }, { "type": "null" } ]
    },
    "counterfactual": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": [
            "laneFingerprint",
            "composition",
            "comparisonFactDigest",
            "transferFactDigest",
            "riskClass",
            "gate",
            "wouldFail",
            "reasons",
            "providerPackageVersion",
            "surfaceVersion",
            "comparisonExportVersion",
            "transferExportVersion"
          ],
          "properties": {
            "laneFingerprint": { "type": "string", "minLength": 1 },
            "composition": { "type": "string", "minLength": 1 },
            "comparisonFactDigest": { "type": ["string", "null"] },
            "transferFactDigest": { "type": ["string", "null"] },
            "riskClass": { "type": "string", "enum": ["none", "low", "high"] },
            "gate": { "type": "string", "enum": ["pass", "audit", "fail"] },
            "wouldFail": { "type": "boolean" },
            "reasons": {
              "type": "array",
              "items": { "type": "string" }
            },
            "providerPackageVersion": { "type": "string", "minLength": 1 },
            "surfaceVersion": { "type": "string", "minLength": 1 },
            "comparisonExportVersion": { "type": ["string", "null"] },
            "transferExportVersion": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "artifacts": { "type": ["object", "null"] },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signer", "keyId", "signature"],
        "properties": {
          "signer": { "type": "string", "minLength": 1 },
          "keyId": { "type": "string", "minLength": 1 },
          "signature": { "type": "string", "minLength": 1 },
          "createdAt": { "type": ["string", "null"], "format": "date-time" },
          "alg": { "type": ["string", "null"], "description": "Signing algorithm. Supported values: \"ed25519\", or null when unsigned." }
        },
        "additionalProperties": false
      },
      "default": []
    }
  },
  "additionalProperties": false
}
