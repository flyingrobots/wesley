{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wesley.dev/schemas/ir.schema.json",
  "title": "Wesley Domain-Empty Canonical IR",
  "description": "Normalized semantic representation of GraphQL SDL. Preserves types, fields, and directives without target-specific semantics.",
  "type": "object",
  "required": ["version", "types"],
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "metadata": { "$ref": "#/definitions/Metadata" },
    "types": {
      "type": "array",
      "items": { "$ref": "#/definitions/TypeDefinition" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Metadata": {
      "type": "object",
      "properties": {
        "sourceHash": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "units": { "type": "array", "items": { "$ref": "#/definitions/UnitMeta" } }
      },
      "additionalProperties": false
    },
    "UnitMeta": {
      "type": "object",
      "required": ["id", "hash"],
      "properties": {
        "id": { "type": "string" },
        "package": { "type": "string" },
        "hash": { "type": "string" }
      }
    },
    "TypeDefinition": {
      "type": "object",
      "required": ["name", "kind", "directives"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "enum": ["OBJECT", "INTERFACE", "UNION", "ENUM", "SCALAR", "INPUT_OBJECT"] },
        "description": { "type": "string" },
        "directives": { "$ref": "#/definitions/DirectiveMap" },
        "fields": { "type": "array", "items": { "$ref": "#/definitions/Field" } },
        "enumValues": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Field": {
      "type": "object",
      "required": ["name", "type", "directives"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "$ref": "#/definitions/TypeReference" },
        "directives": { "$ref": "#/definitions/DirectiveMap" }
      }
    },
    "TypeReference": {
      "type": "object",
      "required": ["base", "nullable", "isList"],
      "properties": {
        "base": { "type": "string" },
        "nullable": { "type": "boolean" },
        "isList": { "type": "boolean" },
        "listItemNullable": { "type": "boolean" }
      }
    },
    "DirectiveMap": {
      "type": "object",
      "additionalProperties": {
        "type": ["object", "boolean", "string", "number", "array"]
      },
      "description": "Generic map of directive name to arguments object or boolean true."
    }
  }
}
