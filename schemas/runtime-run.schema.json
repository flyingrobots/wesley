{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wesley.dev/schemas/runtime-run.schema.json",
  "title": "Wesley Runtime Run Report",
  "type": "object",
  "required": ["runId", "transmutation", "streamId", "status", "eventCount", "artifactCount", "taskCounts"],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "transmutation": { "type": "string", "minLength": 1 },
    "streamId": { "type": "string", "minLength": 1 },
    "command": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["pending", "running", "completed", "failed", "cancelled"] },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "lastEventAt": { "type": ["string", "null"], "format": "date-time" },
    "eventCount": { "type": "integer", "minimum": 0 },
    "artifactCount": { "type": "integer", "minimum": 0 },
    "taskCounts": {
      "type": "object",
      "required": ["started", "completed", "failed", "skipped"],
      "properties": {
        "started": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "dryRun": { "type": ["boolean", "null"] },
    "verdict": { "type": ["string", "null"] },
    "scores": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "scs": { "type": ["number", "null"] },
            "mri": { "type": ["number", "null"] },
            "tci": { "type": ["number", "null"] },
            "readiness": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "failure": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["code"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
