{
  "name": "@wesley/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Legacy compatibility CLI for historical Wesley Node commands",
  "wesley": {
    "retirement": {
      "status": "legacy-compatibility",
      "disposition": "delete-after-command-migration",
      "ledger": "docs/design/0017-rust-native-front-door-and-node-retirement/NODE_RETIREMENT_LEDGER.md",
      "replacement": "Use the native Rust `wesley` binary from `cargo wesley` or `cargo install wesley-cli`; keep this package only for legacy command compatibility."
    }
  },
  "exports": {
    ".": "./src/index.mjs",
    "./src/main.mjs": "./src/main.mjs",
    "./src/program.mjs": "./src/program.mjs"
  },
  "files": [
    "src/"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs && ./test/run-bats.sh",
    "test:verbose": "node --test test/*.test.mjs && ./test/run-bats.sh --verbose",
    "test:tap": "node --test test/*.test.mjs && ./test/run-bats.sh --tap"
  },
  "dependencies": {
    "@wesley/core": "workspace:*",
    "@wesley/generator-js": "workspace:*",
    "@wesley/holmes": "workspace:^",
    "@wesley/runtime-node": "workspace:*",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "chokidar": "^4.0.3",
    "commander": "^14.0.2",
    "graphql": "^16.11.0"
  },
  "keywords": [
    "cli",
    "graphql",
    "schema",
    "generator"
  ],
  "author": "Wesley Authors <oss@flyingrobots.dev>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/flyingrobots/wesley.git",
    "directory": "packages/wesley-cli"
  },
  "bugs": {
    "url": "https://github.com/flyingrobots/wesley/issues"
  },
  "homepage": "https://github.com/flyingrobots/wesley/tree/main/packages/wesley-cli#readme"
}
