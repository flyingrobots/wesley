{
  "name": "@wesley/host-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Legacy compatibility browser host experiment",
  "wesley": {
    "retirement": {
      "status": "legacy-compatibility",
      "disposition": "delete-or-externalize",
      "ledger": "docs/design/0017-rust-native-front-door-and-node-retirement/NODE_RETIREMENT_LEDGER.md",
      "replacement": "Externalize or delete the browser host experiment after its legacy compatibility evidence is obsolete."
    }
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": {
      "browser": "./src/index.mjs",
      "default": "./src/index.mjs"
    }
  },
  "sideEffects": false,
  "files": [
    "src/"
  ],
  "keywords": [
    "graphql",
    "browser",
    "adapters",
    "runtime"
  ],
  "author": "Wesley Authors <oss@flyingrobots.dev>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/flyingrobots/wesley.git",
    "directory": "packages/wesley-host-browser"
  },
  "bugs": {
    "url": "https://github.com/flyingrobots/wesley/issues"
  },
  "homepage": "https://github.com/flyingrobots/wesley/tree/main/packages/wesley-host-browser#readme",
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@wesley/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.7"
  }
}
