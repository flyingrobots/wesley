{
  "name": "@wesley/runtime-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Legacy compatibility Node runtime adapters for historical Wesley packages",
  "wesley": {
    "retirement": {
      "status": "legacy-compatibility",
      "disposition": "extract-or-delete",
      "ledger": "docs/design/0017-rust-native-front-door-and-node-retirement/NODE_RETIREMENT_LEDGER.md",
