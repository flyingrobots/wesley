      "schema lowering",
      "operation metadata extraction",
      "artifact emission"
    ],
    "wesleyDoesNotOwn": [
      "runtime execution",
      "text editing semantics",
      "Echo host behavior",
      "jedit product behavior"
    ]
  }
}
